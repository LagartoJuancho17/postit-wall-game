#!/bin/sh
# Gate: deterministic local tests, under 2 s. The Python and Node lanes are
# independent, so they run side by side; most of the time is interpreter
# and OpenCV start-up, not the tests.
set -eu
if [ -x .venv/bin/python ]; then
  PY=.venv/bin/python
else
  PY=python3.12
fi
NODE_LOG=$(mktemp "${TMPDIR:-/tmp}/postit-gate-node.XXXXXX")
trap 'rm -f "$NODE_LOG"' EXIT
node --test services/web/tests/*.test.mjs >"$NODE_LOG" 2>&1 &
NODE_PID=$!
PY_STATUS=0
PYTHONPATH=. "$PY" -m unittest discover -s . -p 'test_*.py' -q || PY_STATUS=$?
NODE_STATUS=0
wait "$NODE_PID" || NODE_STATUS=$?
if [ "$NODE_STATUS" -ne 0 ]; then
  cat "$NODE_LOG"
else
  grep -E '^ℹ (tests|pass|fail)' "$NODE_LOG" || true
fi
[ "$PY_STATUS" -eq 0 ] && [ "$NODE_STATUS" -eq 0 ]
