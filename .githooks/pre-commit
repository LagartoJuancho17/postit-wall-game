#!/bin/sh
# All deterministic gates: Node plus six disjoint Python lanes, in parallel.
# Full OpenCV browser parity and quality evals run in scripts/verify.sh.
set -eu
if [ -x .venv/bin/python ]; then
  PY=.venv/bin/python
else
  PY=python3.12
fi
POSTIT_GATE_DIR=$(mktemp -d "${TMPDIR:-/tmp}/postit-gate.XXXXXX")
trap 'rm -f "$POSTIT_GATE_DIR"/*; rmdir "$POSTIT_GATE_DIR"' EXIT
node --test services/web/tests/*.test.mjs >"$POSTIT_GATE_DIR/node" 2>&1 &
POSTIT_PIDS="$!"
for lane in matrix live web sim vision core; do
  PYTHONPATH=. "$PY" scripts/gate_tests.py "$lane" >"$POSTIT_GATE_DIR/$lane" 2>&1 &
  POSTIT_PIDS="$POSTIT_PIDS $!"
done
POSTIT_GATE_STATUS=0
for pid in $POSTIT_PIDS; do
  wait "$pid" || POSTIT_GATE_STATUS=1
done
for lane in matrix live web sim vision core; do
  cat "$POSTIT_GATE_DIR/$lane"
done
if [ "$POSTIT_GATE_STATUS" -ne 0 ]; then
  cat "$POSTIT_GATE_DIR/node"
else
  grep -E '^ℹ (tests|pass|fail)' "$POSTIT_GATE_DIR/node" || true
fi
exit "$POSTIT_GATE_STATUS"
